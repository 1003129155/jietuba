// Every app setting, one row each: tool_settings.h turns the rows into typed get_/set_ accessors,
// tool_settings.cpp into the defaults, the lookups by name and the import list.
//
// SETTING(name, path, type, default, scope, getter, setter)
// SETTING_AS(accessor, name, path, ...) when the accessors are named differently from the setting.
//   name    the key of get_app_setting and app_defaults
//   scope   Import: taken from an imported settings file; Local: bound to this computer, kept in the
//           registry rather than the settings file (SettingsStore) and never imported;
//           Internal: no settings page shows it, so imports leave it out
//   getter  Gen: generated; Own: written by hand in ToolSettingsManager
//   setter  Gen: generated; Trim: generated, stores the text trimmed; Own: by hand; None: read-only
